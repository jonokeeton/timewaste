# --- Claude (optional; without it, timewaste uses canned stalling replies) ---
ANTHROPIC_API_KEY=

# --- Userbot mode: replies to scammers in YOUR Telegram DMs ---
# Get these at https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# Engage automatically when a stranger's message looks like a scam.
# If false, only chats you mark with ".waste" get replies.
AUTO_ENGAGE=false
SCAM_THRESHOLD=3

# --- Bot mode: a regular @BotFather bot ---
TG_BOT_TOKEN=
# Your numeric Telegram user id. You get "suggested reply" mode; everyone
# else who messages the bot is treated as a scammer and gets baited.
OWNER_ID=

# --- Shared ---
PERSONA=gerald
MODEL=claude-opus-5-5
DB_PATH=timewaste.db
# Seconds to wait before replying (min,max). Slow replies waste more time.
REPLY_DELAY=20,120
